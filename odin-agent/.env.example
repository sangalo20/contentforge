# Vertex AI via ADC (run: gcloud auth application-default login). No API keys needed.
GOOGLE_CLOUD_PROJECT=your-gcp-project
VERTEX_LOCATION=global

# Optional model overrides (bare names route to Vertex AI)
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash
# LOKI_MODEL / HUGINN_MODEL / MIMIR_MODEL default to GEMINI_FLASH_MODEL
# HEIMDALL_MODEL and LOKI_FALLBACK_MODEL default to GEMINI_MODEL
IMAGE_MODEL=gemini-3-pro-image
