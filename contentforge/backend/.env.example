GCP_PROJECT_ID=your-gcp-project-id
STORAGE_BUCKET=                    # optional — defaults to <GCP_PROJECT_ID>.firebasestorage.app
SANITY_API_TOKEN_MOGULS=sk...      # Editor token for project fqfrsx19 (the-moguls-medium-blogs)
SANITY_API_TOKEN_REAL_REP=sk...    # Editor token for project l4nrg0gu (the-real-rep-substack-blogs)
PORT=3005
# Transactional email (optional — skipped silently when unset)
RESEND_API_KEY=                    # Resend API key; @mention/review emails need it
EMAIL_FROM=                        # sender, e.g. "ContentForge <no-reply@storagemoguls.ai>"
APP_BASE_URL=                      # base URL for links in emails — defaults to https://contentforge.storagemoguls.ai; set to http://localhost:5193 in dev
